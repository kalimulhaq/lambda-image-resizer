{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ImageResizerObjectAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET_NAME/*"
    },
    {
      "Sid": "ImageResizerListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_YOUR_BUCKET_NAME"
    }
  ]
}
